# Never run install scripts from dependencies.
# Every package Sallora uses ships ready-made binaries, so nothing needs compiling. Without this
# line, npm tries to compile better-sqlite3 with C++ build tools when it installs from
# package-lock.json, and fails on most laptops. It is also safer: install scripts are a common
# way for a compromised package to run code on your machine.
ignore-scripts=true
