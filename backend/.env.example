# Optional settings for the back end. Copy this file to backend/.env to change them.
# backend/.env is git-ignored: real keys (later: the Claude API key) go there, never into git.

# Where the API listens. The front end (Vite) uses port 5173 and forwards /api here.
API_PORT=3000
API_HOST=localhost

# The SQLite file, relative to the backend folder. Never committed.
DATABASE_FILE=data/sallora.db
