TableGroup venue_and_people {
  venues
  users
  venue_members
  invites
  consents
  access_windows
}

TableGroup devices_and_floor_map {
  boxes
  cameras
  snapshots
  zones
  dining_tables
  sections
}

TableGroup service {
  outages
  table_events
  alerts
  shifts
  shift_assignments
